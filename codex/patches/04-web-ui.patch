+            {
+                "id": "r1",
+                "title": "Добавить тесты",
+                "action": "add",
+                "why": "Повышает надежность",
+                "source": "https://example.com/r1",
+            },
+            {
+                "id": "r2",
+                "title": "Совет по архитектуре",
+                "action": "warn",
